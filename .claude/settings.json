{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive-bash.js\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.js\""
          }
        ]
      }
    ]
  }
}
